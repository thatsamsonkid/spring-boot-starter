# Secret values for local debug / run. Copy to .env.secrets (gitignored):
#   cp .env.secrets.example .env.secrets
#
# Never commit .env.secrets or paste real tokens into launch.json / tasks.json.
#
# How this is consumed:
#   - Java debugger: launch.json envFile -> .env.secrets
#   - Maven task:    "maven: spring-boot:run (env files)" sources this file
#   - Alternative:   export SANDBOX_API_TOKEN before starting VS Code
#                    (launch config "Sandbox: Debug (host environment secrets)")
#   - Alternative:   debug config "Sandbox: Debug (prompt for secrets)"
#
# Placeholder only — the service does not require this token today.
# Use the same pattern when you add an authenticated client or datasource.

SANDBOX_API_TOKEN=replace-me
