# Non-secret local defaults for sandbox-service.
# Copy to .env (gitignored):  cp .env.example .env
# Or run the VS Code task "env: create local files from examples".
#
# Spring Boot binds these automatically (SPRING_PROFILES_ACTIVE -> spring.profiles.active).
# launch.json "Sandbox: Debug" loads this file via envFile, then .env.secrets on top.

SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
LOGGING_LEVEL_IO_UNBYTE_SANDBOX=DEBUG
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=INFO
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
MANAGEMENT_METRICS_TAGS_ENVIRONMENT=local
